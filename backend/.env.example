PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_pet_health
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d

# Secure admin bootstrap (never put these values in frontend code)
ADMIN_EMAIL=admin@smartpethealth.local
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=SmartPet Admin
ADMIN_PHONE=9999999999

# Optional one-time setup if no admin exists yet
ADMIN_SETUP_SECRET=change_this_setup_secret
